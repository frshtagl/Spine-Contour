# Patient-level data and derived clinical artifacts must never enter Git.
data/
datasets/
raw/
masks/
annotations/private/
reference_readings/
patient_manifests/
splits/private/
runs/
outputs/
results/private/
exports/private/
colab/private/

# Common medical image formats.
*.dcm
*.dicom
*.nii
*.nii.gz
*.nrrd
*.mha
*.mhd
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.webp

# Model and training artifacts: deny by default.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.pkl
*.pickle
*.parquet
*.h5
*.hdf5

# Explicit LFS allow-list for recovered checkpoints.
# Do not add these files until this repository has been changed to PRIVATE.
!recovered_kits/vertebra_unet_finetune/weights/*.pt
!recovered_kits/hrnet_landmarks_finetune/weights/*.pt
!recovered_kits/s1_finetune/weights/*.pt
!recovered_kits/femoral/weights/*.pt
!recovered_kits/vertebra_unet_finetune/weights/*.pth
!recovered_kits/hrnet_landmarks_finetune/weights/*.pth
!recovered_kits/s1_finetune/weights/*.pth
!recovered_kits/femoral/weights/*.pth

# Local logs and notebook checkpoints.
*.log
.ipynb_checkpoints/
